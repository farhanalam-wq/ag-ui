# Environment Configuration
RUNTIME_ENV=development
NODE_ENV=development

# Server Ports & URLs
PORT=3001
WEB_PORT=3000
NEXT_PUBLIC_BACKEND_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_WEB_URL=http://localhost:3000
APP_URL=http://localhost:3000

# Embed widget (anonymous + Redis rate-limit)
EMBED_RATE_PER_MIN=30
EMBED_RATE_PER_DAY=200

# Analytics ingestion + reads (all fail-open when Redis is down; see rate-limit.ts)
# Tracking collector budgets (per key-hash + IP backstop, per-key daily quota)
TRACK_RATE_PER_MIN=1000
TRACK_RATE_PER_DAY=50000
TRACK_QUOTA_PER_DAY=100000
# Dashboard read budget. Per tenant (company + IP) first, then a generous
# per-IP backstop for scrapers; 429 + Retry-After when exceeded.
ANALYTICS_READ_COMPANY_PER_MIN=240
ANALYTICS_READ_COMPANY_PER_DAY=5000
ANALYTICS_READ_PER_MIN=1200
ANALYTICS_READ_PER_DAY=50000
# Worker rollup tick + raw retention (rollups keep history; raw partitions drop)
ANALYTICS_ROLLUP_MS=900000
ANALYTICS_RAW_RETAIN_MONTHS=3
# Set to 1 to bypass the Redis cache layer (diagnostics only)
# REDIS_CACHE_OFF=1

# Database (PostgreSQL + pgvector)
DATABASE_URL=postgresql://postgres:password@localhost:5432/ag_ui

# Redis (BullMQ Queues & sha256 Embedding Cache)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Qdrant Vector Database
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_DUAL_WRITE=false

# AI Providers (LLM, Embeddings, Voice)
OPENAI_API_KEY=
GOOGLE_API_KEY=
SARVAM_API_KEY=
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=

# LiveKit Voice AI Agent (WebRTC real-time audio)
NEXT_PUBLIC_LIVEKIT_URL=
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# VoiceKit web-call provider (server-side token mint for voice chat)
# VOICEKIT_API_KEY is server-only — never prefix with NEXT_PUBLIC_.
VOICEKIT_API_URL=
VOICEKIT_API_KEY=
VOICEKIT_ASSISTANT_ID=

# Voice RAG webhook (VoiceKit tool query_company_knowledge -> POST /api/voice/tool/query)
# Server-only bearer secret. Generate with `openssl rand -hex 32`. Never NEXT_PUBLIC_.
VOICE_TOOL_SECRET=

# External Assets & Media
NEXT_PUBLIC_PIXABAY_API_KEY=
MEDIA_BASE_URL=

# Auth & Google OAuth
# Public web origin used for CORS, CSRF, and post-login redirects.
APP_URL=http://localhost:3000
# Public API origin used for the default Google redirect URI.
API_URL=http://localhost:3001
# Session lifetime. Opaque DB-backed sessions; no signing secret.
SESSION_TTL_HOURS=168
# Only set when web and API are sibling subdomains (e.g. .example.com).
COOKIE_DOMAIN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/api/auth/google/callback
