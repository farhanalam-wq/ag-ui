# Environment Configuration
RUNTIME_ENV=development
NODE_ENV=development

# Server Ports & URLs
PORT=3001
WEB_PORT=3000
NEXT_PUBLIC_BACKEND_URL=http://localhost:3001
APP_URL=http://localhost:3000

# Database (PostgreSQL + pgvector)
DATABASE_URL=postgresql://postgres:password@localhost:5432/ag_ui

# Redis (BullMQ Queues & sha256 Embedding Cache)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Qdrant Vector Database
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# AI Providers (LLM, Embeddings, Voice)
OPENAI_API_KEY=
GOOGLE_API_KEY=
SARVAM_API_KEY=
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=

# LiveKit Voice AI Agent (WebRTC real-time audio)
NEXT_PUBLIC_LIVEKIT_URL=
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# External Assets & Media
NEXT_PUBLIC_PIXABAY_API_KEY=
MEDIA_BASE_URL=

# Auth & Google OAuth
SECRET_KEY=
CLIENT_SESSION_HOURS=4
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
NEXTJS_CALLBACK_URL=
ADMIN_DOMAIN=
